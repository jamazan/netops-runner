# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
DB_PATH=/app/data/netops.db
CORS_ORIGIN=https://your-domain.com,http://your-ip:8080

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── ContainerLab host ────────────────────────────────────────────────────────
CLAB_HOST=10.0.0.71
CLAB_USER=jamazan
CLAB_KEY=/app/ssh/server
CLAB_LAB_NAME=multi-site-fabric

# ── Fault library (legacy file-based faults) ─────────────────────────────────
FAULT_DIR=/home/jamazan/netops-faults

# ── MCP servers (on clab host) ───────────────────────────────────────────────
CEOS_MCP_URL=http://10.0.0.71:8085
CRPD_MCP_URL=http://10.0.0.71:8084
SKILLS_MCP_URL=http://10.0.0.71:8083

# ── Skills repository ────────────────────────────────────────────────────────
SKILLS_REPO=https://github.com/your-org/your-skills-repo.git
SKILLS_REPO_PATH=/home/jamazan/agent-neo
SKILLS_DIR=/home/jamazan/network-skills
